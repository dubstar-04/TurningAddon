root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 127

[*.{json,fctb,fctl,xml,svg,yml,yaml}]
indent_size = 2

# Qt Designer writes one-space indents.
[*.ui]
indent_size = 1

[*.md]
trim_trailing_whitespace = false
